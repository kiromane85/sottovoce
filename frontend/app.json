{
  "expo": {
    "name": "Sottovoce",
    "slug": "sottovoce",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "sottovoce",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sottovoce.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Ascolto la canzone per riconoscerla"
      }
    },
    "android": {
      "package": "com.sottovoce.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#09090B"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#09090B"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Sottovoce ascolta la canzone per riconoscerla."
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": ["text/*"]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "SottovoceMicWidget",
              "label": "Sottovoce — Riconosci brano",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "description": "Tocca per registrare e riconoscere un brano",
              "previewImage": "./assets/images/adaptive-icon.png",
              "updatePeriodMillis": 0,
              "resizeMode": "horizontal|vertical",
              "widgetCategory": "home_screen"
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
